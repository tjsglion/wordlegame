# Database
# 本示例默认本地隔离模式（不写生产库）：先运行 npm run db:dev
# （turso dev 基于 local.db 监听 :8080），应用通过 HTTP 访问
# （@libsql/client/web 不支持 file: URL）。
# 如需直连生产 Turso：把 DATABASE_URL 改为 libsql://xxx.turso.io 并在下方
# DATABASE_AUTH_TOKEN 填入生产 token。
DATABASE_URL=http://127.0.0.1:8080
# 站点正式域名，用于 canonical / hreflang / OAuth 回调
APP_ORIGIN=https://wordlegame.app
# Google AdSense 总开关；仅建议生产环境显式设为 1
NEXT_PUBLIC_GOOGLE_ADSENSE_ENABLED=0
# Google AdSense 发布商 ID（公开值，可直接暴露到前端）
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=
# 生产环境 Turso 数据库的 auth token；本地隔离模式留空
DATABASE_AUTH_TOKEN=
# Optional public origin for the Strands anonymous completion API. Leave empty
# when the client should not submit scores; use the deployed site URL for the
# same-origin Next.js route.
NEXT_PUBLIC_WORKER_API_URL=

# Auth.js
# 生成方式：openssl rand -base64 32
AUTH_SECRET=replace-with-generated-secret
# 生产环境建议固定为站点主域名，避免 OAuth 在多域名入口下回调 host 漂移
AUTH_URL=https://wordlegame.app
# Cloudflare Workers / 反向代理场景需要显式信任转发头
AUTH_TRUST_HOST=true

# OAuth: Google
# 在 https://console.cloud.google.com/apis/credentials 创建 OAuth Client，
# 回调地址为 ${APP_ORIGIN}/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# OAuth: GitHub
# 在 https://github.com/settings/developers 创建 OAuth App，
# 回调地址为 ${APP_ORIGIN}/api/auth/callback/github
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# 硅基流动：Strands 的 Cron 生成每日题（聊天模型 + 向量模型）。
# 生产环境通过 `npm run cf:sync-env` 同步为 Cloudflare Worker secrets。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# 构建期生成 Stackdown 提示 clue 用（npm run clues，见 scripts/generate-clues.ts）。
DEEPSEEK_API_KEY=your-deepseek-api-key
