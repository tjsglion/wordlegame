{
  "name": "wordlegame",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test:wordle": "tsx scripts/test-wordle-sync.ts",
    "test:strands": "tsx scripts/test-strands.ts",
    "test:stackdown": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-stackdown.ts",
    "test:stackdown-sync": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-stackdown-sync.ts",
    "test:wordplay": "tsx scripts/test-wordplay.ts",
    "icons": "node scripts/generate-icons.mjs",
    "words": "node scripts/build-wordlist.mjs",
    "build:wordplay-levels": "node scripts/build-wordplay-levels.mjs",
    "clues": "tsx scripts/generate-clues.ts",
    "clues:push": "tsx scripts/push-clues.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:sync:turso": "node scripts/sync-db-to-turso.mjs",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/drizzle/seed.ts",
    "db:seed:wordle": "tsx src/lib/drizzle/seed-wordle.ts",
    "db:seed:strands": "tsx src/lib/drizzle/seed-strands.ts",
    "db:seed:strands-dictionary": "tsx src/lib/drizzle/seed-strands-dictionary.ts",
    "db:topup:wordle": "tsx src/lib/drizzle/topup-wordle.ts",
    "db:dev": "turso dev --db-file local.db",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:sync-env": "node scripts/sync-cloudflare-env.mjs",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.7.0",
    "@libsql/client": "^0.15.0",
    "@opennextjs/cloudflare": "^1.20.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.0",
    "next-themes": "^0.4.6",
    "pixi.js": "^8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "an-array-of-english-words": "^2.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "naughty-words": "^1.2.0",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.4",
    "subtlex-word-frequencies": "^2.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "wrangler": "^4.0.0"
  }
}
